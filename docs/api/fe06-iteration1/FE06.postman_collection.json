{
  "info": {
    "name": "WMSD FE06 Iteration 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Import into Thunder Client. Synthetic seeded IDs only. Copy login token, evidence receipt and created SO ID manually as described in README."
  },
  "item": [
    {
      "name": "00 Login",
      "item": [
        {
          "name": "Login Sales",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "description": "200. Copy data.accessToken to environment accessToken. Login another role to test permissions.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"sales@ceratile.vn\",\n  \"password\": \"Sales@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login Owner",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "description": "200. Copy data.accessToken to environment accessToken. Login another role to test permissions.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"owner@ceratile.vn\",\n  \"password\": \"Owner@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login Accountant",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "description": "200. Copy data.accessToken to environment accessToken. Login another role to test permissions.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"accountant@ceratile.vn\",\n  \"password\": \"KeToan@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login Warehouse",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "description": "200. Copy data.accessToken to environment accessToken. Login another role to test permissions.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"warehouse@ceratile.vn\",\n  \"password\": \"Kho@12345678\"\n}",
              "options": {
