        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "description": "200. Copy data.accessToken to environment accessToken. Login another role to test permissions.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin@ceratile.vn\",\n  \"password\": \"Admin@123\"\n}",
