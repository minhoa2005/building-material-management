PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/sep490?replicaSet=rs0
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Seed: chi insert toan bo du lieu demo khi DB hoan toan trong; can replica set / Atlas
SEED_ON_STARTUP=true
# Chi dung voi CLI seed: cap nhat quyen role da co, khong insert; startup khong sync quyen
SEED_SYNC_ROLE_PERMISSIONS=false
