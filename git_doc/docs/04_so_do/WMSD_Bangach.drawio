  <diagram id="cgOVGXXjEJiPQmt8FiAg" name="BF04 Mới">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#10;  &quot;data&quot;: &quot;@startuml\ntitle BF-04 - Stocktake &amp; Inventory Adjustment\n\n|Store Owner|\nstart\n:Create stocktake;\n\n|WMSD|\n:Create stocktake scope;\n:Capture book balance at cut-off;\n\n|Inventory Staff|\n:Enter physical count;\n\n|WMSD|\n:Compare physical count\nwith book balance;\n:Calculate variance;\n\nif (Variance detected?) then (Yes)\n\n  |Inventory Staff|\n  :Perform recount;\n  :Record variance cause;\n\n  |WMSD|\n  :Update verified variance;\n\n  |Inventory Staff|\n  :Create adjustment request;\n\n  |WMSD|\n  :Record before/after quantities\n  and adjustment request;\n\n  |Store Owner|\n  :Review adjustment request;\n\n  if (Adjustment approved?) then (Yes)\n\n    |WMSD|\n    :Record approval;\n\n    |Inventory Staff|\n    :Post approved adjustment;\n\n    |WMSD|\n    :Update inventory balance;\n    :Record adjustment history;\n\n  else (No)\n\n    |WMSD|\n    :Keep current inventory balance;\n\n  endif\n\nelse (No)\n\n  |WMSD|\n  :Mark stocktake as completed;\n\nendif\n\nstop\n@enduml&quot;,&#10;  &quot;config&quot;: null&#10;}" id="tYOHVjUy58ouDNk6KBcP-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
