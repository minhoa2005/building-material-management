        <mxCell id="bf08-request" value="&lt;b&gt;1. Đề nghị trả, cách ly/giữ đúng lượng&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52667e&quot;&gt;SR · UC-81&lt;/font&gt;" vertex="1" parent="bf08-lane-wh" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#24354b;rounded=1;arcSize=10;align=center;spacing=12;verticalAlign=middle;fontSize=15;fillColor=#eaf1fb;strokeColor=#6b88ac;strokeWidth=1.5;" data-uc-references="[&quot;UC-81&quot;]">
