        <mxCell id="bf08-dispatch" value="&lt;b&gt;4. Soạn, bàn giao và post trả thực tế&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52667e&quot;&gt;GI-SR / CUS-OUT · UC-82&lt;/font&gt;" vertex="1" parent="bf08-lane-wh" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#24354b;rounded=1;arcSize=10;align=center;spacing=12;verticalAlign=middle;fontSize=15;fillColor=#e8f4ed;strokeColor=#438463;strokeWidth=1.5;" data-uc-references="[&quot;UC-82&quot;]">
