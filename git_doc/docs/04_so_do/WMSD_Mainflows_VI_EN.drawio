        <mxCell id="bf08-variance" value="&lt;b&gt;6. Duyệt xử lý sai lệch nếu có&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52667e&quot;&gt;UC-106 · preserve actual GI&lt;/font&gt;" vertex="1" parent="bf08-lane-owner" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#24354b;rounded=1;arcSize=10;align=center;spacing=12;verticalAlign=middle;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" data-uc-references="[&quot;UC-106&quot;]">
