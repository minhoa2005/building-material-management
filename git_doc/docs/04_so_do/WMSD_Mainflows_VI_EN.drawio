        </mxCell>
        <mxCell id="bf08-agreement" value="&lt;b&gt;2. Ghi NCC đồng ý, lịch và lượng&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52667e&quot;&gt;UC-107 · before dispatch&lt;/font&gt;" vertex="1" parent="bf08-lane-acct" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#24354b;rounded=1;arcSize=10;align=center;spacing=12;verticalAlign=middle;fontSize=15;fillColor=#eaf1fb;strokeColor=#6b88ac;strokeWidth=1.5;" data-uc-references="[&quot;UC-107&quot;]">
