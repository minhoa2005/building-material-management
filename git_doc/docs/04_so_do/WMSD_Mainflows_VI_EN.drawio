        <mxCell id="bf08-legend" value="Blue: action/document · Yellow: decision · Green: stock/task confirmation · Purple: confirmation with no inventory effect" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#24354b;text;align=left;fontSize=12;fontColor=#52667e;">
