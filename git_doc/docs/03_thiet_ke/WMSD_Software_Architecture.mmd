  classDef external fill:#F3ECF8,stroke:#80609C,color:#392749,stroke-width:1.5px;
  classDef boundary fill:#FFFFFF,stroke:#8391A1,color:#334155,stroke-width:1.5px;
  class Roles actor;
  class SPA,UI,State frontend;
  class API,Security,Master,Inventory,Procurement,Fulfilment,Support,Domain,Command,Ledger,Jobs backend;
  class Mongo persistence;
  class Cloud,SMTP,MISA external;
  class Access,Client,Server,Modules,Consistency,Data boundary;
