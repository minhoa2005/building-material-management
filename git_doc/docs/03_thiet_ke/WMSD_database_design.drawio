  <diagram id="page_d8_views" name="8. Khung nhìn Dẫn xuất (Views)">
    <mxGraphModel dx="1700" dy="1300" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="1300" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="views_title" value="&lt;b&gt;8. Khung nhìn dẫn xuất · Baseline 3.0.0&lt;/b&gt;&lt;br&gt;Read-only projections từ DDL tham chiếu; nhấp quay lại tổng quan." vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#24354b;text;align=left;verticalAlign=top;fontSize=15;spacing=12;" link="data:page/id,page_overview">
          <mxGeometry x="40" y="30" width="1580" height="100" as="geometry" />
        </mxCell>
        <mxCell id="inventory_ledger" value="&lt;b&gt;wmsd.inventory_ledger&lt;/b&gt;&lt;br&gt;Movement hai đầu → delta âm/dương theo balance; closing=opening+SUM(delta). Ledger số lượng, không phải tiền.&lt;br&gt;&lt;br&gt;Nguồn: stock_movement" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#24354b;rounded=1;spacing=16;align=left;verticalAlign=top;fontSize=17;fillColor=#eaf1fb;strokeColor=#6c8ebf;" data-model-id="inventory_ledger" data-view-source="CREATE VIEW wmsd.inventory_ledger AS&#10; SELECT movement_id, batch_id, from_balance_id AS balance_id, -qty_base AS delta_qty&#10; FROM wmsd.stock_movement WHERE from_balance_id IS NOT NULL&#10; UNION ALL&#10; SELECT movement_id, batch_id, to_balance_id AS balance_id, qty_base AS delta_qty&#10; FROM wmsd.stock_movement WHERE to_balance_id IS NOT NULL;">
          <mxGeometry x="50" y="190" width="1500" height="210" as="geometry" />
        </mxCell>
        <mxCell id="inventory_ledger_source_stock_movement" value="stock_movement" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#24354b;rounded=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#a2adba;" link="data:page/id,page_d7_inventory">
          <mxGeometry x="70" y="440" width="185" height="80" as="geometry" />
        </mxCell>
        <mxCell id="view_inventory_ledger_stock_movement" value="" edge="1" parent="1" source="inventory_ledger_source_stock_movement" target="inventory_ledger" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#24354b;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8695a8;endArrow=block;exitX=0.5;exitY=0;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="available_stock" value="&lt;b&gt;wmsd.available_stock&lt;/b&gt;&lt;br&gt;Chỉ STORE/GOOD/VERIFIED, master/location active, allocatable, không freeze; trừ ACTIVE reservation đúng balance. Không transit/custody/staging rảnh.&lt;br&gt;&lt;br&gt;Nguồn: location, location_lock, lot, party, product, reservation, stock_account, stock_balance, warehouse" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#24354b;rounded=1;spacing=16;align=left;verticalAlign=top;fontSize=17;fillColor=#eaf1fb;strokeColor=#6c8ebf;" data-model-id="available_stock" data-view-source="CREATE VIEW wmsd.available_stock AS&#10; SELECT b.balance_id, l.warehouse_id, l.location_id, b.lot_id,&#10;        b.qty_base - COALESCE(r.reserved_qty,0) AS available_qty&#10; FROM wmsd.stock_balance b&#10; JOIN wmsd.stock_account a ON a.account_id=b.account_id&#10; JOIN wmsd.location l ON l.location_id=a.location_id&#10; JOIN wmsd.warehouse w ON w.warehouse_id=l.warehouse_id&#10; JOIN wmsd.party p ON p.party_id=b.owner_party_id&#10; JOIN wmsd.lot lot_ref ON lot_ref.lot_id=b.lot_id&#10; JOIN wmsd.product pr ON pr.product_id=lot_ref.product_id&#10; LEFT JOIN (SELECT balance_id, SUM(qty_base) AS reserved_qty FROM wmsd.reservation&#10;            WHERE status='ACTIVE' GROUP BY balance_id) r ON r.balance_id=b.balance_id&#10; WHERE p.party_kind='STORE' AND b.quality_code='GOOD'&#10;   AND lot_ref.identification_status='VERIFIED' AND pr.active = 1&#10;   AND l.active = 1 AND w.active = 1 AND l.allocatable = 1&#10;   AND NOT EXISTS (SELECT 1 FROM wmsd.location_lock k WHERE k.location_id=l.location_id);">
          <mxGeometry x="50" y="620" width="1500" height="210" as="geometry" />
        </mxCell>
        <mxCell id="available_stock_source_location" value="location" vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#24354b;rounded=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#a2adba;" link="data:page/id,page_d1_iam_org">
          <mxGeometry x="70" y="870" width="185" height="80" as="geometry" />
        </mxCell>
        <mxCell id="view_available_stock_location" value="" edge="1" parent="1" source="available_stock_source_location" target="available_stock" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#24354b;edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8695a8;endArrow=block;exitX=0.5;exitY=0;entryX=0.05555555555555555;entryY=1;">
          <mxGeometry relative="1" as="geometry" />
