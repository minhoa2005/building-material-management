        <mxCell id="ov_banner" value="&lt;b&gt;WMSD · Baseline 3.0.0 · 22/10/2026&lt;/b&gt;&lt;br&gt;73 bảng · 2 views · 173 ràng buộc FK&lt;br&gt;SQL Server/T-SQL: mô hình tham chiếu. MongoDB: runtime.&lt;br&gt;Nguồn: WMSD_SQL_schema.sql · Không phải backend hoặc migration đã triển khai." vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#24354b;text;align=left;verticalAlign=top;fontSize=15;fillColor=#eaf1fb;strokeColor=#6c8ebf;spacing=16;">
          <mxGeometry x="50" y="30" width="1850" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ov_guide" value="Mỗi bảng có một định nghĩa đầy đủ tại trang gốc; mỗi FK có stub xám cục bộ liên kết tới bảng đích.&lt;br&gt;Nhấp vào thẻ phân hệ để mở trang. FK composite là một quan hệ kèm đầy đủ danh sách cột.&lt;br&gt;Business operation cho SO/POD/PAY-CFM không ghi tồn; posting batch/movement dùng cho tác động kho." vertex="1" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontColor=#24354b;text;align=left;verticalAlign=top;fontSize=15;">
          <mxGeometry x="50" y="210" width="1850" height="100" as="geometry" />
        </mxCell>
